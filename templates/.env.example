# Copy to .env (gitignored). Loaded by Acorn via env().

# Resend API key — https://resend.com/api-keys
# Required for the contact form to send mail. Without it the endpoint
# returns { ok:false, error:"not_configured" } and logs a warning.
RESEND_API_KEY=

# From address. For production, use an address on a domain you've verified
# in the Resend dashboard (with DKIM + SPF records). For initial testing,
# Resend provides `onboarding@resend.dev` — per their docs, this is for
# TESTING ONLY (not production). Switch to a verified-domain sender before
# going live.
RESEND_FROM=onboarding@resend.dev

# Where contact form messages are delivered. Defaults to WP admin_email
# when unset.
CONTACT_TO=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Free, GDPR-friendly, invisible CAPTCHA. Register a widget at the URL above,
# then paste the site key + secret key here. Leave empty during local dev to
# skip the Turnstile check entirely (the form still works, CAPTCHA just
# degrades to "no-op"). Set BOTH or NEITHER — one key alone leaves the layer
# off and logs a warning on every submission, because no widget renders
# without a site key. Widget mode MUST be "Managed" — Invisible returns
# HTTP 400 from challenges.cloudflare.com.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
